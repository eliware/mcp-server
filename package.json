{
    "name": "@eliware/mcp-server",
    "type": "module",
    "version": "1.1.9",
    "description": "Pure-ESM Node.js MCP server with automatic tool discovery, Streamable HTTP and stdio transports, TLS, Zod schemas, injectable context, bearer authentication, and generic OAuth2 support.",
    "files": [
        "index.mjs",
        "index.d.ts",
        "container.mjs",
        "README.md",
        "LICENSE",
        "examples/",
        "src/"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        }
    },
    "scripts": {
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --coverage --detectOpenHandles --silent --runInBand",
        "lint": "npx oxlint .",
        "test:gaps": "npm test && node scripts/check-coverage.mjs",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/mcp-server.git"
    },
    "keywords": [
        "mcp",
        "mcp-server",
        "model-context-protocol",
        "streamable-http",
        "stdio",
        "stateless",
        "nodejs",
        "esm",
        "dynamic-tools",
        "tool-discovery",
        "zod",
        "authentication",
        "oauth2",
        "pkce",
        "tls",
        "dependency-injection",
        "ai-tools"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/mcp-server/issues"
    },
    "homepage": "https://github.com/eliware/mcp-server#readme",
    "devDependencies": {
        "jest": "^30.4.2",
        "oxlint": "^1.79.0",
        "supertest": "^7.2.2",
        "typescript": "^7.0.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).mjs"
        ]
    },
    "dependencies": {
        "@eliware/common": "^1.1.8",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "express": "^5.1.0"
    },
    "types": "index.d.ts"
}